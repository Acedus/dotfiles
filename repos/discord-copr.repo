[copr:copr.fedorainfracloud.org:pyra:discord]
name=Copr repo for discord owned by pyra
baseurl=https://download.copr.fedorainfracloud.org/results/pyra/discord/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/pyra/discord/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
priority=1
